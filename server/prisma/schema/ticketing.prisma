// DDC Ticketing — фаза 1: площадки, версионируемые схемы зала, события, сеансы и инвентарь.
// Контракт и обоснования: docs/ticketing/DATABASE_DESIGN.md.
//
// CHECK-ограничения на ticket_session_seats добавлены вручную в SQL миграции
// (Prisma их не описывает) — при генерации следующих миграций не удалять:
//   status = 'HELD'                  => hold_id IS NOT NULL AND order_item_id IS NULL
//   status = 'SOLD'                  => order_item_id IS NOT NULL
//   status IN ('AVAILABLE','BLOCKED') => hold_id IS NULL AND order_item_id IS NULL
// И на суммы (миграция add_ticketing_orders):
//   ticket_orders:   total_cents = subtotal_cents + fee_cents, 0 <= refunded_cents <= total_cents
//   ticket_payments, ticket_order_items: суммы неотрицательны

enum TicketSeatMapStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TicketEventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TicketSessionStatus {
  DRAFT
  ON_SALE
  PAUSED
  CLOSED
  CANCELLED
}

enum TicketSeatStatus {
  AVAILABLE
  HELD
  SOLD
  BLOCKED
}

enum TicketHoldStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

enum TicketOrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
  NEEDS_REVIEW
}

enum TicketOrderItemStatus {
  ACTIVE
  CANCELLED
  REFUNDED
}

enum TicketPaymentMode {
  TEST
  LIVE
}

enum TicketPaymentEventSource {
  WEBHOOK
  RECONCILE
  RETURN
}

model TicketVenue {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  city      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seatMaps TicketSeatMap[]

  @@map("ticket_venues")
}

// Версия схемы зала. PUBLISHED неизменяема: правка = клон в новую DRAFT-версию.
model TicketSeatMap {
  id            Int                 @id @default(autoincrement())
  venueId       Int                 @map("venue_id")
  version       Int
  status        TicketSeatMapStatus @default(DRAFT)
  name          String
  canvas        Json?
  publishedAt   DateTime?           @map("published_at")
  publishedById Int?                @map("published_by_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  venue       TicketVenue          @relation(fields: [venueId], references: [id], onDelete: Restrict)
  publishedBy User?                @relation("TicketSeatMapPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  categories  TicketSeatCategory[]
  seats       TicketSeat[]
  sessions    TicketSession[]

  @@unique([venueId, version])
  @@index([publishedById])
  @@map("ticket_seat_maps")
}

model TicketSeatCategory {
  id        Int    @id @default(autoincrement())
  seatMapId Int    @map("seat_map_id")
  code      String @db.VarChar(32)
  name      String
  // 1..8 -> токены --style-N-*-redesigned; сырой цвет не хранится.
  colorSlot Int    @default(1) @map("color_slot") @db.TinyInt
  sortOrder Int    @default(0) @map("sort_order")

  seatMap TicketSeatMap        @relation(fields: [seatMapId], references: [id], onDelete: Cascade)
  seats   TicketSeat[]
  prices  TicketSessionPrice[]

  @@unique([seatMapId, code])
  @@map("ticket_seat_categories")
}

model TicketSeat {
  id               Int     @id @default(autoincrement())
  seatMapId        Int     @map("seat_map_id")
  categoryId       Int     @map("category_id")
  sectionLabel     String  @default("") @map("section_label") @db.VarChar(32)
  rowLabel         String  @map("row_label") @db.VarChar(16)
  seatLabel        String  @map("seat_label") @db.VarChar(16)
  x                Int
  y                Int
  rotation         Int     @default(0)
  isAccessible     Boolean @default(false) @map("is_accessible")
  isDefaultBlocked Boolean @default(false) @map("is_default_blocked")

  seatMap      TicketSeatMap       @relation(fields: [seatMapId], references: [id], onDelete: Cascade)
  category     TicketSeatCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sessionSeats TicketSessionSeat[]
  orderItems   TicketOrderItem[]

  @@unique([seatMapId, sectionLabel, rowLabel, seatLabel])
  @@index([categoryId])
  @@map("ticket_seats")
}

model TicketEvent {
  id              Int               @id @default(autoincrement())
  slug            String            @unique @db.VarChar(120)
  title           String
  description     String?           @db.Text
  posterUrl       String?           @map("poster_url") @db.Text
  businessBrandId Int?              @map("business_brand_id")
  status          TicketEventStatus @default(DRAFT)
  createdById     Int?              @map("created_by_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  businessBrand BusinessBrand?  @relation(fields: [businessBrandId], references: [id], onDelete: SetNull)
  createdBy     User?           @relation("TicketEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sessions      TicketSession[]

  @@index([businessBrandId])
  @@index([createdById])
  @@map("ticket_events")
}

model TicketSession {
  id                   Int                 @id @default(autoincrement())
  eventId              Int                 @map("event_id")
  seatMapId            Int                 @map("seat_map_id")
  startsAt             DateTime            @map("starts_at")
  doorsAt              DateTime?           @map("doors_at")
  salesStartAt         DateTime?           @map("sales_start_at")
  salesEndAt           DateTime?           @map("sales_end_at")
  status               TicketSessionStatus @default(DRAFT)
  holdTtlSeconds       Int                 @default(600) @map("hold_ttl_seconds")
  maxSeatsPerOrder     Int                 @default(8) @map("max_seats_per_order")
  currency             String              @default("EUR") @db.Char(3)
  inventoryGeneratedAt DateTime?           @map("inventory_generated_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  event   TicketEvent          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  seatMap TicketSeatMap        @relation(fields: [seatMapId], references: [id], onDelete: Restrict)
  prices  TicketSessionPrice[]
  seats   TicketSessionSeat[]
  holds   TicketHold[]
  orders  TicketOrder[]

  @@index([eventId, startsAt])
  @@index([seatMapId])
  @@map("ticket_sessions")
}

model TicketSessionPrice {
  sessionId  Int @map("session_id")
  categoryId Int @map("category_id")
  priceCents Int @map("price_cents")

  session  TicketSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  category TicketSeatCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([sessionId, categoryId])
  @@index([categoryId])
  @@map("ticket_session_prices")
}

// Инвентарь: ровно одна строка на место сеанса. Первичный ключ (session_id, seat_id) —
// главный инвариант «одна активная аллокация на сеанс/место».
model TicketSessionSeat {
  sessionId   Int              @map("session_id")
  seatId      Int              @map("seat_id")
  status      TicketSeatStatus @default(AVAILABLE)
  holdId      Int?             @map("hold_id")
  // onUpdate: Restrict у связи с hold обязателен: MySQL запрещает CHECK по колонке,
  // участвующей во внешнем ключе с каскадным действием.
  // То же правило onUpdate: Restrict действует для связи с позицией заказа.
  orderItemId Int?             @unique @map("order_item_id")
  priceCents  Int              @map("price_cents")
  blockReason String?          @map("block_reason")
  version     Int              @default(0)
  updatedAt   DateTime         @updatedAt @map("updated_at")

  session   TicketSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  seat      TicketSeat       @relation(fields: [seatId], references: [id], onDelete: Restrict)
  hold      TicketHold?      @relation(fields: [holdId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orderItem TicketOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([sessionId, seatId])
  @@index([sessionId, status])
  @@index([seatId])
  @@index([holdId])
  @@map("ticket_session_seats")
}

// Срок удержания живёт только здесь (expires_at); в строке места срока нет намеренно.
model TicketHold {
  id           Int              @id @default(autoincrement())
  sessionId    Int              @map("session_id")
  // SHA-256 от opaque-токена; сам токен не хранится.
  tokenHash    String           @unique @map("token_hash") @db.Char(64)
  status       TicketHoldStatus @default(ACTIVE)
  expiresAt    DateTime         @map("expires_at")
  seatCount    Int              @map("seat_count")
  clientIpHash String?          @map("client_ip_hash") @db.Char(64)
  createdAt    DateTime         @default(now()) @map("created_at")
  releasedAt   DateTime?        @map("released_at")

  session TicketSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  seats   TicketSessionSeat[]
  order   TicketOrder?

  @@index([status, expiresAt])
  @@index([sessionId])
  @@map("ticket_holds")
}

// Заказ покупателя. Покупатель хранится здесь, а не в Client/Customer. Пока заказ ждёт оплаты,
// его места остаются HELD за hold в статусе CONVERTED; SOLD они становятся при подтверждении платежа.
model TicketOrder {
  id                Int               @id @default(autoincrement())
  // Человекочитаемый номер; случайный, чтобы не раскрывать объём продаж.
  number            String            @unique @db.VarChar(16)
  // SHA-256 от opaque-токена доступа покупателя; сам токен не хранится.
  accessTokenHash   String            @unique @map("access_token_hash") @db.Char(64)
  sessionId         Int               @map("session_id")
  // Один заказ на hold — идемпотентность создания заказа.
  holdId            Int               @unique @map("hold_id")
  buyerName         String            @map("buyer_name")
  buyerEmail        String            @map("buyer_email")
  buyerPhone        String?           @map("buyer_phone") @db.VarChar(32)
  locale            String            @default("nl") @db.VarChar(5)
  subtotalCents     Int               @map("subtotal_cents")
  feeCents          Int               @default(0) @map("fee_cents")
  totalCents        Int               @map("total_cents")
  currency          String            @default("EUR") @db.Char(3)
  refundedCents     Int               @default(0) @map("refunded_cents")
  status            TicketOrderStatus @default(PENDING_PAYMENT)
  paymentDeadlineAt DateTime          @map("payment_deadline_at")
  paidAt            DateTime?         @map("paid_at")
  cancelledAt       DateTime?         @map("cancelled_at")
  reviewReason      String?           @map("review_reason")
  // Снимок события на момент покупки: заказ остаётся самодостаточным после правок события.
  eventSnapshot     Json              @map("event_snapshot")
  termsAcceptedAt   DateTime          @map("terms_accepted_at")
  termsVersion      String            @map("terms_version") @db.VarChar(32)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  session  TicketSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  hold     TicketHold        @relation(fields: [holdId], references: [id], onDelete: Restrict)
  items    TicketOrderItem[]
  payments TicketPayment[]

  @@index([buyerEmail])
  @@index([sessionId, status])
  @@index([status, paymentDeadlineAt])
  @@map("ticket_orders")
}

// Позиция заказа = одно место. Подписи и цена — снимки на момент покупки.
model TicketOrderItem {
  id           Int                   @id @default(autoincrement())
  orderId      Int                   @map("order_id")
  sessionId    Int                   @map("session_id")
  seatId       Int                   @map("seat_id")
  sectionLabel String                @default("") @map("section_label") @db.VarChar(32)
  rowLabel     String                @map("row_label") @db.VarChar(16)
  seatLabel    String                @map("seat_label") @db.VarChar(16)
  categoryName String                @map("category_name")
  priceCents   Int                   @map("price_cents")
  status       TicketOrderItemStatus @default(ACTIVE)

  order       TicketOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seat        TicketSeat         @relation(fields: [seatId], references: [id], onDelete: Restrict)
  sessionSeat TicketSessionSeat?

  @@unique([orderId, seatId])
  @@index([sessionId, seatId])
  @@index([seatId])
  @@map("ticket_order_items")
}

// Платёж Mollie по заказу. Ключ идемпотентности создаётся и сохраняется до вызова Mollie.
model TicketPayment {
  id               Int               @id @default(autoincrement())
  orderId          Int               @map("order_id")
  molliePaymentId  String?           @unique @map("mollie_payment_id") @db.VarChar(64)
  idempotencyKey   String            @unique @map("idempotency_key") @db.Char(36)
  // CREATED — строка есть, платёж в Mollie ещё не создан; далее нормализованный статус Mollie.
  status           String            @default("CREATED") @db.VarChar(24)
  amountCents      Int               @map("amount_cents")
  currency         String            @default("EUR") @db.Char(3)
  method           String?           @db.VarChar(32)
  checkoutUrl      String?           @map("checkout_url") @db.Text
  mollieExpiresAt  DateTime?         @map("mollie_expires_at")
  paidAt           DateTime?         @map("paid_at")
  refundedCents    Int               @default(0) @map("refunded_cents")
  chargedBackCents Int               @default(0) @map("charged_back_cents")
  lastSyncedAt     DateTime?         @map("last_synced_at")
  mollieMode       TicketPaymentMode @map("mollie_mode")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  order TicketOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status, lastSyncedAt])
  @@map("ticket_payments")
}

// Журнал сигналов о платеже (webhook, сверка, возврат покупателя). Только журнал: без
// dedupe-ключа, идемпотентность дают условные переходы под блокировкой заказа.
model TicketPaymentEvent {
  id              Int                      @id @default(autoincrement())
  molliePaymentId String                   @map("mollie_payment_id") @db.VarChar(64)
  source          TicketPaymentEventSource
  observedStatus  String?                  @map("observed_status") @db.VarChar(24)
  payload         Json?
  outcome         String?                  @db.VarChar(32)
  errorMessage    String?                  @map("error_message") @db.Text
  receivedAt      DateTime                 @default(now()) @map("received_at")
  processedAt     DateTime?                @map("processed_at")

  @@index([molliePaymentId, receivedAt])
  @@map("ticket_payment_events")
}
