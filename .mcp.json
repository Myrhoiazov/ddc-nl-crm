{
    "mcpServers": {
        "graphify": {
            "command": "python",
            "args": [
                "-m",
                "graphify.serve",
                "graphify-out/graph.json"
            ]
        },
        "chrome-devtools": {
            "command": "npx",
            "args": [
                "-y",
                "chrome-devtools-mcp@1.10.1",
                "--isolated",
                "--viewport=1440x900",
                "--no-usage-statistics",
                "--no-performance-crux"
            ],
            "env": {
                "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
            }
        }
    }
}
